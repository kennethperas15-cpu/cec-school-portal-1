# Copy to .env and fill in your Google Cloud OAuth Client ID (Web application type).
# Get one at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origin: http://127.0.0.1:5173
VITE_GOOGLE_CLIENT_ID=
VITE_API_URL=/api
# Optional live AI backend (OpenAI-compatible chat-completions). Leave empty for instant built-in answers.
# VITE_AI_API_URL=https://api.openai.com/v1/chat/completions
# VITE_AI_API_KEY=sk-...
# VITE_AI_MODEL=gpt-4o-mini
