# Production build (vite build). Every API route is mounted under /api on the
# server (server/src/index.ts: app.use('/api', routes)), so this base URL must
# carry it. Leaving it off makes the portal call https://<api-host>/auth/login
# instead of https://<api-host>/api/auth/login: the request 404s with an HTML
# body, which has no `message` field, so sign-in failed with a vague sentence
# and left no trace on the server. Local development uses the "/api" value in
# .env, which the dev-server proxy forwards to 127.0.0.1:4000.
VITE_API_URL=https://cec-portal-api-5i1q.onrender.com/api
