{
  "name": "student-portal-template",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A modern, polished Student Portal Dashboard template (React + Vite + Tailwind + Recharts + Lucide).",
  "scripts": {
    "predev": "node scripts/build-portal.mjs --soft",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "portal:build": "node scripts/build-portal.mjs --force",
    "typecheck": "tsc --noEmit",
    "smoke": "vite build --ssr src/ssr-smoke.tsx --outDir dist-ssr --logLevel error && node dist-ssr/ssr-smoke.js"
  },
  "dependencies": {
    "lucide-react": "^0.400.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
